# Prefer deploy/create-production-env.sh for standard domain deployments.
# Copy this file to deploy/production.env and replace every placeholder only
# when you need manual customization.
# Use: docker compose --env-file deploy/production.env -f docker-compose.prod.yml up -d --build

# Public site handled by Caddy. Use a real DNS name for automatic HTTPS.
PLEXA_SITE_ADDRESS=plexa.example.edu
ACME_EMAIL=admin@example.edu
PLEXA_HTTP_PORT=80
PLEXA_HTTPS_PORT=443

# Local Postgres container credentials. Keep this file out of git.
POSTGRES_DB=plexa
POSTGRES_USER=plexa
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Server runtime.
PLEXA_ENV=production
PLEXA_DATABASE_URL=postgresql+asyncpg://plexa:replace-with-a-long-random-password@postgres:5432/plexa
PLEXA_DATABASE_SYNC_URL=postgresql://plexa:replace-with-a-long-random-password@postgres:5432/plexa
PLEXA_AUTH_MODE=dev-header
PLEXA_ENABLE_DEV_LOGIN=true
PLEXA_ADMIN_USER_IDS=["admin"]
PLEXA_CORS_ALLOWED_ORIGINS=["https://plexa.example.edu"]
PLEXA_LOG_ENCRYPTION_KEY=replace-with-generated-log-encryption-key

# Backend-only inference target. This can be an institutional GPU host, a GPU VPS,
# or any OpenAI-compatible endpoint reachable by plexa_server.
PLEXA_INFERENCE_BACKENDS={"primary":{"type":"openai-compatible","base_url":"https://inference.example.edu/v1","timeout_s":30.0}}
PLEXA_INFERENCE_PROFILES={"default":{"backend_id":"primary","model":"replace-with-model-name"},"fast":{"backend_id":"primary","model":"replace-with-model-name"},"reasoning":{"backend_id":"primary","model":"replace-with-model-name"}}
PLEXA_INFERENCE_REQUIRED_BACKENDS=["primary"]

# Portal build-time config.
VITE_APP_ENV=production
VITE_API_BASE_URL=/api
TARGET_API_VERSION=v1
VITE_AUTH_MODE=dev
VITE_ENABLE_DEV_LOGIN=true
