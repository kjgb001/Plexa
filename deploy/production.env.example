# Prefer deploy/create-production-env.sh for standard domain deployments.
# Copy this file to deploy/production.env and replace every placeholder only
# when you need manual customization.
# Use: deploy/start-production.sh deploy/production.env

# Public site handled by Caddy. Use a real DNS name for automatic HTTPS.
PLEXA_DEPLOY_ENV_FILE=deploy/production.env
PLEXA_SITE_ADDRESS=plexa.example.edu
ACME_EMAIL=admin@example.edu
PLEXA_HTTP_PORT=80
PLEXA_HTTPS_PORT=443

# Local Postgres container credentials. Keep this file out of git.
POSTGRES_DB=plexa
POSTGRES_USER=plexa
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Server runtime. Register a public Authorization Code + PKCE client and replace
# every OIDC placeholder before serving users.
PLEXA_ENV=production
PLEXA_DATABASE_URL=postgresql+asyncpg://plexa:replace-with-a-long-random-password@postgres:5432/plexa
PLEXA_DATABASE_SYNC_URL=postgresql://plexa:replace-with-a-long-random-password@postgres:5432/plexa
PLEXA_AUTH_MODE=bearer-jwt
PLEXA_ENABLE_DEV_LOGIN=false
PLEXA_ADMIN_USER_IDS=["replace-with-initial-admin-subject"]
PLEXA_AUTH_ISSUER=https://login.example.edu
PLEXA_AUTH_AUDIENCE=plexa-api
PLEXA_AUTH_JWKS_URL=https://login.example.edu/.well-known/jwks.json
PLEXA_AUTH_ALLOWED_ALGORITHMS=RS256
PLEXA_AUTH_REQUIRE_EXP=true
PLEXA_AUTH_USER_ID_CLAIM=sub
PLEXA_AUTH_ROLES_CLAIM=roles
PLEXA_AUTH_ADMIN_ROLE_NAME=plexa-admin
PLEXA_CORS_ALLOWED_ORIGINS=["https://plexa.example.edu"]
PLEXA_LOG_ENCRYPTION_KEYS_FILE=/run/secrets/log_encryption_key
PLEXA_LOG_ENCRYPTION_ACTIVE_KEY_ID=server-managed:v1
PLEXA_LOG_ENCRYPTION_KEY_HOST_FILE=deploy/secrets/production.log-encryption-key
PLEXA_CONTENT_RETENTION_DAYS=365
PLEXA_WEB_CONCURRENCY=1
PLEXA_LOG_FORMAT=json
PLEXA_ALLOW_INSECURE_INFERENCE=false

# Backend-only inference target. This can be an institutional GPU host, a GPU VPS,
# or any OpenAI-compatible endpoint reachable by plexa_server. Add "api_key" to
# the backend object when the endpoint requires a bearer token. Prefer
# deploy/create-production-env.sh --api-key <path> over hand-editing JSON.
PLEXA_INFERENCE_BACKENDS={"primary":{"type":"openai-compatible","base_url":"https://inference.example.edu/v1","timeout_s":30.0,"api_key_file":"/run/secrets/inference_api_key"}}
PLEXA_INFERENCE_PROFILES={"default":{"backend_id":"primary","model":"replace-with-model-name"},"fast":{"backend_id":"primary","model":"replace-with-model-name"},"reasoning":{"backend_id":"primary","model":"replace-with-model-name"}}
PLEXA_INFERENCE_REQUIRED_BACKENDS=["primary"]
PLEXA_INFERENCE_API_KEY_HOST_FILE=deploy/secrets/production.inference-api-key

# Portal build-time config.
VITE_APP_ENV=production
VITE_API_BASE_URL=/api
TARGET_API_VERSION=v1
VITE_AUTH_MODE=oidc
VITE_ENABLE_DEV_LOGIN=false
VITE_AUTH_AUTHORITY=https://login.example.edu
VITE_AUTH_DISCOVERY_URL=https://login.example.edu/.well-known/openid-configuration
VITE_AUTH_CLIENT_ID=plexa
VITE_AUTH_SCOPE=openid profile email
VITE_AUTH_REDIRECT_URI=https://plexa.example.edu/auth/callback
VITE_AUTH_LOGOUT_REDIRECT_URI=https://plexa.example.edu/login
