{
  email {$ACME_EMAIL}
}

{$PLEXA_SITE_ADDRESS:localhost} {
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  @api path /api /api/*
  handle @api {
    reverse_proxy plexa_server:8000
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
