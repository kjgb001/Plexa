{
  email {$ACME_EMAIL}
}

{$PLEXA_SITE_ADDRESS:localhost} {
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' https:; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https:"
  }

  request_body {
    max_size 1MB
  }

  @api path /api /api/*
  handle @api {
    reverse_proxy plexa_server:8000 {
      flush_interval -1
    }
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
