# Local production-mode smoke test.
# Copy to deploy/local-production.env and use it with:
# deploy/start-production.sh deploy/local-production.env

# Caddy listens on container port 80 and is exposed on host port 8080.
PLEXA_DEPLOY_ENV_FILE=deploy/local-production.env
PLEXA_SITE_ADDRESS=:80
ACME_EMAIL=admin@example.invalid
PLEXA_HTTP_PORT=8080
PLEXA_HTTPS_PORT=8443

POSTGRES_DB=plexa
POSTGRES_USER=plexa
POSTGRES_PASSWORD=plexa_local_prod_password

PLEXA_ENV=production
PLEXA_DATABASE_URL=postgresql+asyncpg://plexa:plexa_local_prod_password@postgres:5432/plexa
PLEXA_DATABASE_SYNC_URL=postgresql://plexa:plexa_local_prod_password@postgres:5432/plexa
PLEXA_AUTH_MODE=dev-header
PLEXA_ENABLE_DEV_LOGIN=true
PLEXA_ADMIN_USER_IDS=["admin"]
PLEXA_CORS_ALLOWED_ORIGINS=["http://localhost:8080"]
PLEXA_LOG_ENCRYPTION_KEYS_FILE=/run/secrets/log_encryption_key
PLEXA_LOG_ENCRYPTION_ACTIVE_KEY_ID=server-managed:v1
PLEXA_LOG_ENCRYPTION_KEY_HOST_FILE=deploy/secrets/local-production.log-encryption-key
PLEXA_CONTENT_RETENTION_DAYS=30
PLEXA_WEB_CONCURRENCY=1
PLEXA_LOG_FORMAT=json
PLEXA_ALLOW_INSECURE_INFERENCE=true

# Use host.docker.internal when your inference server runs on the same machine as
# Docker. For Ollama, make sure it is listening on an address Docker can reach,
# not only 127.0.0.1. Check with:
# ss -ltnp 'sport = :11434'
# systemctl cat ollama
# systemctl show ollama -p FragmentPath -p DropInPaths -p Environment
PLEXA_INFERENCE_BACKENDS={"primary":{"type":"openai-compatible","base_url":"http://host.docker.internal:11434/v1","timeout_s":30.0,"api_key_file":"/run/secrets/inference_api_key"}}
PLEXA_INFERENCE_PROFILES={"default":{"backend_id":"primary","model":"llama3.1"},"fast":{"backend_id":"primary","model":"qwen2.5:7b"},"reasoning":{"backend_id":"primary","model":"deepseek-r1-distill-qwen-7b"}}
PLEXA_INFERENCE_REQUIRED_BACKENDS=["primary"]
PLEXA_INFERENCE_API_KEY_HOST_FILE=deploy/secrets/local-production.inference-api-key

VITE_APP_ENV=production
VITE_API_BASE_URL=/api
TARGET_API_VERSION=v1
VITE_AUTH_MODE=dev
VITE_ENABLE_DEV_LOGIN=true
